digraph vllm_vs_vllm_metal_for_hooks {
  graph [
    rankdir=TB,
    splines=ortho,
    bgcolor="white",
    pad="0.25",
    nodesep="0.45",
    ranksep="0.9",
    label="vLLM vs vLLM-Metal: Differences That Matter for vLLM-Hook",
    labelloc="t",
    fontsize=18,
    fontname="Helvetica-Bold"
  ];

  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=10,
    margin="0.14,0.08"
  ];

  edge [
    arrowsize=0.8,
    penwidth=1.2
  ];

  subgraph cluster_hook {
    label="What vLLM-Hook expects";
    color="#6E6E6E";
    penwidth=1.3;
    style="rounded,dashed";

    h0 [label="Hook workers assume:\nfind target layers,\nattach hooks/callbacks,\ncapture tensors, write qk.pt", fillcolor="#F7F7F7", color="#666666"];
    h1 [label="Analyzers assume:\nexisting artifact schema\nand stable attention semantics", fillcolor="#F7F7F7", color="#666666"];
    h0 -> h1;
  }

  subgraph cluster_vllm {
    label="vLLM / PyTorch path";
    color="#4A86CF";
    penwidth=1.4;
    style="rounded";

    v0 [label="Runtime backend:\nPyTorch", fillcolor="#EAF4FF", color="#1F5AA6"];
    v1 [label="Model shape:\nTorch module tree", fillcolor="#EAF4FF", color="#1F5AA6"];
    v2 [label="Worker can walk\nnamed_modules()", fillcolor="#EAF4FF", color="#1F5AA6"];
    v3 [label="Target modules expose\nregister_forward_hook()", fillcolor="#EAF4FF", color="#1F5AA6"];
    v4 [label="Hook data arrives as\ntorch.Tensor", fillcolor="#EAF4FF", color="#1F5AA6"];
    v5 [label="model.config usually gives\nattention dimensions", fillcolor="#EAF4FF", color="#1F5AA6"];
    v6 [label="Result:\nvLLM-Hook workers map\nnaturally onto runtime", fillcolor="#DDF3E4", color="#2E8B57"];

    v0 -> v1 -> v2 -> v3 -> v4 -> v6;
    v1 -> v5 -> v6;
  }

  subgraph cluster_metal {
    label="vLLM-Metal / MLX path";
    color="#E4A11B";
    penwidth=1.4;
    style="rounded";

    m0 [label="Runtime backend:\nMLX + Metal\n(with some Torch interop)", fillcolor="#FFF7E6", color="#B26A00"];
    m1 [label="Model shape:\nMLX model object", fillcolor="#FFF7E6", color="#B26A00"];
    m2 [label="named_modules() may be\nmissing or non-authoritative", fillcolor="#FDECEC", color="#B03A2E"];
    m3 [label="register_forward_hook()\nis not a safe base assumption", fillcolor="#FDECEC", color="#B03A2E"];
    m4 [label="Internal tensors are\nmx.array, not torch.Tensor", fillcolor="#FFF7E6", color="#B26A00"];
    m5 [label="model.config may be absent;\nmodel_runner.model_args is used instead", fillcolor="#FFF7E6", color="#B26A00"];
    m6 [label="Need explicit callback seam:\nqk_capture_callback", fillcolor="#F7F7F7", color="#666666"];
    m7 [label="Need explicit conversion:\nmx.array -> torch(cpu)", fillcolor="#F7F7F7", color="#666666"];
    m8 [label="Result:\nvLLM-Hook workers do not map\nnaturally without added seams", fillcolor="#FDECEC", color="#B03A2E"];

    m0 -> m1 -> m2 -> m8;
    m1 -> m3 -> m8;
    m1 -> m4 -> m7 -> m8;
    m1 -> m5 -> m8;
    m1 -> m6 -> m8;
  }

  h0 -> v2 [style=dashed, color="#1F5AA6"];
  h0 -> v3 [style=dashed, color="#1F5AA6"];
  h0 -> m6 [style=dashed, color="#666666"];
  h0 -> m7 [style=dashed, color="#666666"];
  h1 -> v6 [style=dashed, color="#2E8B57"];
  h1 -> m8 [style=dashed, color="#B03A2E"];

  note [shape=note, label="Key point:\nvLLM-Hook workers/analyzers were designed around\nvLLM's PyTorch-oriented assumptions.\nvLLM-Metal can support them, but only through extra\nadapter logic rather than by default.", fillcolor="#F7F7F7", color="#888888"];
  v6 -> note [style=dashed, color="#2E8B57"];
  m8 -> note [style=dashed, color="#B03A2E"];
}
