+def test_cache_key_capture_respects_current_offset():
+    keys = np.arange(16, dtype=np.float32).reshape(1, 1, 4, 4)
+    cache = SimpleNamespace(keys=keys, offset=2)
+    assert _cached_keys(cache, keys).shape == (1, 1, 2, 4)
