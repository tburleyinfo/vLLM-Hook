+def test_metal_engine_uses_eager_mia_hooks_without_changing_cpu_cuda_default():
+    metal = resolve_capture_mode(
+        SimpleNamespace(enforce_eager=False, enable_prefix_caching=None),
+        {"VLLM_PLUGINS": "cuda, metal"},
+        kind="qk",
