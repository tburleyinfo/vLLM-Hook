+        finally:
+            qwen2.scaled_dot_product_attention = original_sdpa
+            qwen2.TransformerBlock.__call__ = original_block_call
+            for norm_cls, original_call in patched_norm_classes.items():
+                norm_cls.__call__ = original_call
+            _ACTIVE = None
